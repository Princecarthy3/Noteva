# PostgreSQL connection (use the Supabase pooler URL in production)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=legacy-anon-key-if-needed
# Server-only; required for lecture record/status operations and study-group
# membership, discussion, invitation, and session actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter — server-side only, never prefix with NEXT_PUBLIC_
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional dedicated model for Stage 8 structured study generation.
OPENROUTER_STUDY_MODEL=google/gemini-2.5-flash
# Optional model tried if the study model is unavailable.
OPENROUTER_STUDY_FALLBACK_MODEL=
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3
# OPENROUTER_VIDEO_MODEL=google/gemini-2.5-flash

# Fast, 100% Free Voice/Audio Transcription via Groq Cloud (Recommended)
# Sign up in 30 seconds at https://console.groq.com (no credit card required)
GROQ_API_KEY=your-groq-api-key
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Google Gemini API (Recommended for StudyStation AI Tutor & Note Generation - Free with 1M context: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_STUDY_MODEL=gemini-3.5-flash-lite

# Stage 10 Jitsi prototype; public meet.jit.si rooms are not access-controlled by StudyStation.
JITSI_MEET_DOMAIN=meet.jit.si

# Public Vercel deployment URL
APP_URL=http://localhost:3000

